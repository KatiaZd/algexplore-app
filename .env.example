# =============================
# GLOBAL ENV VARIABLES (example)
# =============================

# PostgreSQL (used by docker-compose)
POSTGRES_USER=__YOUR_DB_USER__
POSTGRES_PASSWORD=__YOUR_DB_PASSWORD__
POSTGRES_DB=__YOUR_DB_NAME__
POSTGRES_PORT=5433

# =============================
# BACKEND ENV VARIABLES
# =============================

# URL for the Postgres database (service name = db inside Docker)
# Example:
# DATABASE_URL=postgresql://<user>:<password>@db:5432/<dbname>?schema=public
DATABASE_URL=postgresql://__YOUR_DB_USER__:__YOUR_DB_PASSWORD__@db:5432/__YOUR_DB_NAME__?schema=public

# Backend server port
PORT=3000

# CORS origins (frontend)
CORS_ORIGINS=http://localhost:4200

# Node environment mode
NODE_ENV=development
